<Page x:Class="NativeHub.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
 <ScrollViewer><StackPanel Padding="24" Spacing="18" MaxWidth="760" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Appearance, units, and Windows integration" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="App theme" FontWeight="SemiBold"/><TextBlock Text="Follow Windows or choose a theme" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="ThemeBox_SelectionChanged"><ComboBoxItem Content="Use system setting" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark" Tag="Dark"/></ComboBox></Grid></Border>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Temperature unit" FontWeight="SemiBold"/><TextBlock Text="Used throughout Weather" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="UnitBox" Grid.Column="1" SelectionChanged="UnitBox_SelectionChanged"><ComboBoxItem Content="Celsius" Tag="C"/><ComboBoxItem Content="Fahrenheit" Tag="F"/></ComboBox></Grid></Border>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Braille guidance" FontWeight="SemiBold"/><TextBlock Text="Show the accessibility notice when Braille numerals are selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="BrailleNoticeToggle" Grid.Column="1" Toggled="BrailleNoticeToggle_Toggled" AutomationProperties.Name="Show Braille guidance"/></Grid></Border>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Keep running in system tray" FontWeight="SemiBold"/><TextBlock Text="Closing the window hides NativeHub" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="TrayToggle" Grid.Column="1" Toggled="TrayToggle_Toggled"/></Grid></Border>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold"/><TextBlock x:Name="StartupStatus" Text="Keep NativeHub and its global shortcut available" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled"/></Grid></Border>
  <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Keyboard shortcuts" Message="Ctrl+1…6 pages · Ctrl+, settings · Ctrl+Alt+Space global search · Enter opens a search result"/>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Send test notification" Click="Notification_Click"/><Button Content="Exit NativeHub" Click="Exit_Click"/></StackPanel>
  <StackPanel Spacing="4"><TextBlock Text="NativeHub 1.0 · Data stays local except weather requests to Open-Meteo." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><HyperlinkButton Content="Third-party licenses and privacy details" NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" Padding="0"/></StackPanel>
 </StackPanel></ScrollViewer>
</Page>
