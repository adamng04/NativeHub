<Page
    x:Class="NativeHub.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NativeHub.Models"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quick notes" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Local plain text, autosave, tags, pins, and reminder notifications" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" MinHeight="44" Content="New note" Click="New_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Ctrl+N" />
        </Grid>

        <Grid x:Name="EditorLayout" Grid.Row="1" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="300" /><ColumnDefinition x:Name="EditorColumn" Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="ListRow" Height="*" /><RowDefinition x:Name="EditorRow" Height="0" /></Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ListColumn.Width" Value="*" />
                            <Setter Target="EditorColumn.Width" Value="0" />
                            <Setter Target="ListRow.Height" Value="2*" />
                            <Setter Target="EditorRow.Height" Value="3*" />
                            <Setter Target="ListPane.(Grid.RowSpan)" Value="1" />
                            <Setter Target="EditorBorder.(Grid.Column)" Value="0" />
                            <Setter Target="EditorBorder.(Grid.Row)" Value="1" />
                            <Setter Target="EditorBorder.(Grid.RowSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel x:Name="ListPane" Grid.RowSpan="2" Spacing="8">
                <TextBox x:Name="FilterBox" MinHeight="44" PlaceholderText="Search notes" TextChanged="FilterBox_TextChanged" />
                <ListView x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged" AutomationProperties.Name="Quick notes">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Note">
                            <StackPanel Padding="8">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Tags}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border x:Name="EditorBorder" Grid.Column="1" Grid.RowSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox x:Name="TitleBox" Header="Title" TextChanged="Editor_TextChanged" />
                    <TextBox x:Name="TagsBox" Grid.Row="1" Header="Tags" PlaceholderText="work, idea" TextChanged="Editor_TextChanged" />
                    <TextBox x:Name="BodyBox" Grid.Row="2" Header="Note" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="Editor_TextChanged" />
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReminderStatus" VerticalAlignment="Bottom" Text="No reminder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CalendarDatePicker x:Name="ReminderDate" Grid.Column="1" Header="Reminder date" MinDate="{x:Bind Today}" />
                        <TimePicker x:Name="ReminderTime" Grid.Column="2" Header="Time" ClockIdentifier="24HourClock" />
                        <Button Grid.Column="3" Content="Set" VerticalAlignment="Bottom" Click="SetReminder_Click" />
                        <Button Grid.Column="4" Content="Clear" VerticalAlignment="Bottom" Click="ClearReminder_Click" />
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="PinToggle" Content="Pin" Click="Pin_Click" />
                        <Button Content="Delete" Click="Delete_Click" />
                        <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
