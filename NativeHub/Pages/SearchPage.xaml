<Page
    x:Class="NativeHub.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NativeHub.Models"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="File search" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Instant indexed filename search powered by Everything" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            x:Name="DependencyInfo"
            Grid.Row="1"
            Severity="Warning"
            Title="Everything is not available"
            Message="Start Everything 1.4 with IPC enabled, then press F5."
            IsClosable="False">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Get Everything" NavigateUri="https://www.voidtools.com/downloads/" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="QueryBox"
                MinHeight="44"
                PlaceholderText="Search names, paths, extensions…"
                QueryIcon="Find"
                TextChanged="QueryBox_TextChanged"
                QuerySubmitted="QueryBox_QuerySubmitted"
                AutomationProperties.Name="File search query" />
            <Button Grid.Column="1" MinWidth="92" Content="Search" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="CaseToggle" Content="Match case" Click="Option_Click" />
            <CheckBox x:Name="PathToggle" Grid.Column="1" Content="Match path" Click="Option_Click" />
            <CheckBox x:Name="WordToggle" Grid.Column="2" Content="Whole word" Click="Option_Click" />
            <CheckBox x:Name="RegexToggle" Grid.Column="3" Content="Regex" Click="Option_Click" />
            <TextBlock
                x:Name="ResultStatus"
                Grid.Column="4"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite" />
            <ComboBox x:Name="SortBox" Grid.Column="5" Header="Sort" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Name A–Z" Tag="NameAscending" />
                <ComboBoxItem Content="Name Z–A" Tag="NameDescending" />
                <ComboBoxItem Content="Newest first" Tag="DateModifiedDescending" />
                <ComboBoxItem Content="Largest first" Tag="SizeDescending" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4">
            <ProgressRing x:Name="Busy" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListView
                x:Name="ResultsList"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                KeyDown="ResultsList_KeyDown"
                AutomationProperties.Name="Search results">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileSearchResult">
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{x:Bind ModifiedLabel}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                <Button Click="Reveal_Click" Tag="{x:Bind FullPath}" ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer"><FontIcon Glyph="&#xE838;" /></Button>
                                <Button Click="CopyPath_Click" Tag="{x:Bind FullPath}" ToolTipService.ToolTip="Copy path" AutomationProperties.Name="Copy path"><FontIcon Glyph="&#xE8C8;" /></Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
