<Page
    x:Class="NativeHub.Pages.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NativeHub.Models"
    Loaded="Page_Loaded">
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Clipboard history" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Native Win+V history — NativeHub never persists clipboard contents" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar x:Name="HistoryInfo" Grid.Row="1" Severity="Warning" Title="Clipboard history unavailable" Message="Enable clipboard history in Windows Settings." IsClosable="False">
            <InfoBar.ActionButton><Button Content="Open clipboard settings" Click="OpenSettings_Click" /></InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" MinHeight="44" PlaceholderText="Filter history" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Filter clipboard history" />
            <TextBlock x:Name="HistoryStatus" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" />
            <Button Grid.Column="3" Content="Clear all" Click="Clear_Click" />
        </Grid>
        <ListView x:Name="HistoryList" Grid.Row="3" SelectionMode="Single" AutomationProperties.Name="Clipboard history items">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ClipboardEntry">
                    <Grid Padding="10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Kind}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="3" />
                        <TextBlock Grid.Column="2" Text="{x:Bind TimestampLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Content="Restore" Click="Restore_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="Place this item on the clipboard" />
                            <Button Click="Delete_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="Delete from Windows clipboard history" AutomationProperties.Name="Delete clipboard item"><FontIcon Glyph="&#xE74D;" /></Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
