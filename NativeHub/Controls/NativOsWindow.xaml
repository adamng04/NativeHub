<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NativeHub.Controls.NativOsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    MinHeight="250">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    </UserControl.Resources>
    <Border
        x:Name="WindowBorder"
        BorderBrush="#FF8097BE"
        BorderThickness="1"
        CornerRadius="7"
        Background="#F51B2331">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="TitleDragArea"
                Background="#FF18365F"
                PointerPressed="TitleDragArea_PointerPressed"
                PointerMoved="TitleDragArea_PointerMoved"
                PointerReleased="TitleDragArea_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="11,0,8,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="TitleIcon" Glyph="&#xE7C3;" FontSize="14" Foreground="White" />
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Width="42"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="Minimize_Click"
                        AutomationProperties.Name="Minimize NativOS window"
                        ToolTipService.ToolTip="Minimize">
                        <FontIcon Glyph="&#xE921;" FontSize="11" />
                    </Button>
                    <Button
                        Width="42"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="Maximize_Click"
                        AutomationProperties.Name="Maximize or restore NativOS window"
                        ToolTipService.ToolTip="Maximize or restore">
                        <FontIcon Glyph="&#xE922;" FontSize="11" />
                    </Button>
                    <Button
                        Width="42"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="Close_Click"
                        AutomationProperties.Name="Close NativOS window"
                        ToolTipService.ToolTip="Close">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFC42B1C" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE81123" />
                        </Button.Resources>
                        <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#F51B2331">
                <ContentPresenter x:Name="AppContentPresenter" />
                <Border
                    x:Name="ResizeGrip"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerReleased="ResizeGrip_PointerReleased"
                    AutomationProperties.Name="Resize window">
                    <FontIcon Glyph="&#xE90D;" FontSize="10" Foreground="#FFB5C9E8" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
