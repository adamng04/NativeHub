<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NativeHub.Controls.FallingBlocksControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootControl"
    IsTabStop="True"
    KeyDown="RootControl_KeyDown"
    PointerPressed="RootControl_PointerPressed">
    <Grid Padding="14" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Padding="4" Background="#FF07101C" BorderBrush="#FF6484B2" BorderThickness="1" CornerRadius="5">
            <Grid x:Name="BoardGrid" Width="240" Height="480" />
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="Falling Blocks" FontSize="24" FontWeight="SemiBold" />
                <Border Padding="10" Background="#FF111B2B" CornerRadius="5">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ScoreText" FontFamily="Cascadia Mono" FontSize="18" />
                        <TextBlock x:Name="LinesText" FontFamily="Cascadia Mono" />
                        <TextBlock x:Name="LevelText" FontFamily="Cascadia Mono" />
                        <TextBlock x:Name="BestScoreText" FontFamily="Cascadia Mono" Foreground="#FF9FD2FF" />
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="HOLD" FontFamily="Cascadia Mono" /><Grid x:Name="HoldGrid" Width="88" Height="70" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="NEXT" FontFamily="Cascadia Mono" /><Grid x:Name="NextGrid" Width="88" Height="70" /></StackPanel>
                </Grid>
                <TextBlock x:Name="GameStatusText" Text="Playing" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="◀" Click="Left_Click" ToolTipService.ToolTip="Move left (Left arrow)" />
                    <Button Content="▶" Click="Right_Click" ToolTipService.ToolTip="Move right (Right arrow)" />
                    <Button Content="↻" Click="Rotate_Click" ToolTipService.ToolTip="Rotate (Up arrow)" />
                    <Button Content="▼" Click="Drop_Click" ToolTipService.ToolTip="Hard drop (Space)" />
                </StackPanel>
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" />
                <Button Content="New game" Click="NewGame_Click" />
                <TextBlock Text="Keyboard: ← → move · ↓ soft drop · ↑/Z rotate · Space hard drop · C hold · P pause" TextWrapping="Wrap" Foreground="#FFB8C8DE" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
