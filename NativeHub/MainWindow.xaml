<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NativeHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NativeHub"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NativeHub"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="NativeHub"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="641"
            ExpandedModeThresholdWidth="1008"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="208"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="File search"
                    IsSelected="True"
                    Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Clipboard" Icon="Paste" Tag="clipboard" />
                <NavigationViewItem Content="Quick notes" Icon="Edit" Tag="notes" />
                <NavigationViewItem Content="Hardware" Icon="AllApps" Tag="hardware" />
                <NavigationViewItem Content="Weather" Icon="Globe" Tag="weather" />
                <NavigationViewItem Content="World clock" Icon="Clock" Tag="clock" />
                <NavigationViewItem Content="NativOS" Tag="nativos">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="NavFrame">
                    <Frame.ContentTransitions><TransitionCollection><NavigationThemeTransition /></TransitionCollection></Frame.ContentTransitions>
                </Frame>
                <InfoBar x:Name="ShellInfoBar" Margin="16" VerticalAlignment="Bottom" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Assertive" />
                <TeachingTip x:Name="TrayTip" Title="NativeHub keeps running" Subtitle="Closing hides NativeHub to the system tray. Use Ctrl+Alt+Space to open file search." PreferredPlacement="Bottom" IsLightDismissEnabled="True" />
            </Grid>
        </NavigationView>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="NavigationShortcut_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="CommandShortcut_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CommandShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
